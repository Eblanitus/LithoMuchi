# Сборка и временные файлы
/target/
/out/
**/*.rs.bk
*.tmp

# Cargo.lock генерируется при сборке. litho-core уходит в Horizon без своего
# Cargo.lock, а у бинарных крейтов пока нет внешних зависимостей, поэтому
# фиксировать лок не обязательно. Пересмотреть на T75 при сборке бандла.
/Cargo.lock

# Локальные настройки редакторов
.idea/
.vscode/
.DS_Store

# Скачанные карты-кандидаты для сравнения: лицензии не проверены, в репозиторий
# не идут. В docs/images/compare/ лежат только перекрашенные производные и
# присланный автором снимок.
/image-search/
