// Runs at the initialization of noise_clamped, after settings_json exists and
// before the density graph compiles. The original None value is returned intact.
// All other settings are retained. No Mojang settings are shipped in our pack.
fn litospherity_lava_settings(
    value: Option<(NoiseSettings, NoiseSettings)>,
    settings: &mut Value,
    data: &Arc<GeneratorData>,
    dimension: &str,
) -> Option<(NoiseSettings, NoiseSettings)> {
    if dimension != "minecraft:overworld" {
        return value;
    }
    let gameplay = data
        .densities
        .contains_key("litospherity:v0/gameplay/active");
    let scientific = data
        .densities
        .contains_key("litospherity:v0/scientific/active");
    let mode = match (gameplay, scientific) {
        (true, false) => "gameplay",
        (false, true) => "scientific",
        _ => return value,
    };
    let Some(aquifers) = settings.get_mut("aquifers").and_then(Value::as_object_mut) else {
        return value;
    };
    let Some(original) = aquifers.get("lava").cloned() else {
        return value;
    };
    // Aquifer samples lava at (block_x / 64, block_y / 40, block_z / 64).
    // floor(y / 40) <= -2 covers blocks strictly below -40.
    // Cell -1 also includes blocks -39..-1, so retain the original there.
    aquifers.insert(
        "lava".into(),
        serde_json::json!({
            "type": "minecraft:range_choice",
            "input": {
                "type": "minecraft:gradient", "axis": "y",
                "from_coordinate": -2, "to_coordinate": 0,
                "from_value": -80, "to_value": 0
            },
            "min_inclusive": -1000000, "max_exclusive": -79,
            "when_in_range": format!("litospherity:v0/{mode}/lava"),
            "when_out_of_range": original
        }),
    );
    value
}
