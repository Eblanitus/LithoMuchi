// Клей LithoNoise и реестр генераторов (план 10.3, T72/T74).
// Модуль поддержки [[module]]: НЕЛЬЗЯ писать //! и #![...], внешние mod-файлы
// и include! (план 5.4). Файл НЕ КОМПИЛИРУЕТСЯ в workspace разработки:
// пути crate::noise::* принадлежат horizon-core и сверяются при первой сборке.
use std::sync::{Arc, Mutex, Weak};

use litho_core::{Field, GenVersion, Generator, Mode};

#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub struct NoiseSpec {
    pub version: GenVersion,
    pub mode: Mode,
    pub field: Field,
}

/// Строгий разбор `litospherity:v0/scientific/continents`.
/// Неизвестная версия, режим или поле -> None (мир не падает, см. 10.2).
pub fn parse_noise_name(name: &str) -> Option<NoiseSpec> {
    let rest = name.strip_prefix("litospherity:")?;
    let mut parts = rest.split('/');
    let version = GenVersion::parse(parts.next()?)?;
    let mode = Mode::parse(parts.next()?)?;
    let field = Field::parse(parts.next()?)?;
    if parts.next().is_some()
        || !matches!(
            field,
            Field::Continents
                | Field::Erosion
                | Field::Ridges
                | Field::Temperature
                | Field::Vegetation
                | Field::Lava
        )
    {
        return None;
    }
    Some(NoiseSpec {
        version,
        mode,
        field,
    })
}

/// Smoke-пак Э2: мир заведомо наш, всюду суша с постоянной континентальностью.
/// Имя `litospherity:smoke/<поле>` не версия и не режим, поэтому разбирается
/// отдельно и не может случайно совпасть с боевым паком.
pub fn smoke_noise(name: &str) -> Option<Arc<dyn crate::noise::Noise>> {
    let field = name
        .strip_prefix("litospherity:smoke/")
        .and_then(Field::parse)?;
    let value = match field {
        Field::Continents => 0.8, // заведомо суша
        _ => 0.0,
    };
    Some(Arc::new(ConstNoise { value }))
}

pub fn noise_for_name(seed: i64, name: &str) -> Option<Arc<dyn crate::noise::Noise>> {
    if let Some(noise) = smoke_noise(name) {
        return Some(noise);
    }
    parse_noise_name(name).and_then(|spec| noise_for(seed, spec))
}

type Key = (i64, u8, u8);
type RegistryEntry = (Key, Weak<Generator>);
static REGISTRY: Mutex<Vec<RegistryEntry>> = Mutex::new(Vec::new());

fn key(seed: i64, spec: NoiseSpec) -> Key {
    let version = if spec.version == GenVersion::V0 { 0 } else { 1 };
    let mode = if spec.mode == Mode::Scientific { 0 } else { 1 };
    (seed, version, mode)
}

/// Один Generator на (seed, mode, version), общий для всех полей мира и LOD.
pub fn noise_for(seed: i64, spec: NoiseSpec) -> Option<Arc<dyn crate::noise::Noise>> {
    let k = key(seed, spec);
    let mut registry = REGISTRY.lock().ok()?;
    registry.retain(|(_, weak)| weak.strong_count() > 0);
    for (existing, weak) in registry.iter() {
        if *existing == k {
            if let Some(generator) = weak.upgrade() {
                return Some(Arc::new(LithoNoise {
                    generator,
                    field: spec.field,
                }));
            }
        }
    }
    let generator = Arc::new(Generator::new(seed, spec.mode, spec.version).ok()?);
    registry.push((k, Arc::downgrade(&generator)));
    Some(Arc::new(LithoNoise {
        generator,
        field: spec.field,
    }))
}

#[derive(Debug)]
pub struct LithoNoise {
    generator: Arc<Generator>,
    field: Field,
}

impl crate::noise::Noise for LithoNoise {
    fn range(&self) -> Result<[f32; 2], crate::noise::NanRange> {
        Ok([-1.0, 1.0])
    }

    fn get2(&self, x: f64, z: f64) -> f32 {
        self.get3(x, 0.0, z)
    }

    fn get3(&self, x: f64, y: f64, z: f64) -> f32 {
        if self.field == Field::Lava {
            self.generator.aquifer_lava(x, y, z) as f32
        } else {
            self.generator.field_column(self.field, x, z) as f32
        }
    }

    // Horizon 66f3981: Z/X/Y layout, scaled coordinates, additive writes.
    // Validate before writing so short buffers remain untouched.
    fn add_to_volume(
        &self,
        buffer: &mut [f32],
        volume: crate::noise::DensityVolume,
        xz_scale: f64,
        y_scale: f64,
        amplitude: f32,
    ) -> Result<(), crate::noise::DensityError> {
        if buffer.len() < volume.size() {
            return Err(crate::noise::DensityError::BufferTooShort);
        }
        let [sx, sy, sz] = volume.sizes();
        let minimum = volume.minimum();
        let steps = volume.steps();
        let mut index = 0;
        for z in 0..sz {
            let z = minimum[2].wrapping_add((z as i32).wrapping_mul(steps[2]));
            for x in 0..sx {
                let x = minimum[0].wrapping_add((x as i32).wrapping_mul(steps[0]));
                let value = if self.field == Field::Lava {
                    0.0
                } else {
                    amplitude * self.get2(f64::from(x) * xz_scale, f64::from(z) * xz_scale)
                };
                for y in 0..sy {
                    let add = if self.field == Field::Lava {
                        let y = minimum[1].wrapping_add((y as i32).wrapping_mul(steps[1]));
                        amplitude
                            * self.get3(
                                f64::from(x) * xz_scale,
                                f64::from(y) * y_scale,
                                f64::from(z) * xz_scale,
                            )
                    } else {
                        value
                    };
                    buffer[index] += add;
                    index += 1;
                }
            }
        }
        Ok(())
    }
}

/// Константный шум для smoke-пака Э2. Диапазон объявлен в датапаке, а не здесь
/// (план 5.3): фиктивное определение обязано накрывать выдаваемые значения.
#[derive(Debug)]
pub struct ConstNoise {
    value: f32,
}

impl crate::noise::Noise for ConstNoise {
    fn range(&self) -> Result<[f32; 2], crate::noise::NanRange> {
        Ok([self.value, self.value])
    }
    fn get2(&self, _x: f64, _z: f64) -> f32 {
        self.value
    }
    fn get3(&self, _x: f64, _y: f64, _z: f64) -> f32 {
        self.value
    }
}

// Explicit inputs, suitable for comparison with the sandbox diagnostic command.
pub fn diagnose(seed: i64, mode: &str, x: f64, z: f64) -> String {
    match Mode::parse(mode) {
        Some(mode) => litho_core::diagnostic::point(seed, mode, x, z).unwrap_or_else(|error| error),
        None => "mode must be gameplay or scientific".into(),
    }
}
