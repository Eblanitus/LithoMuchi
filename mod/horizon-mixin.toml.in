# Шаблон бандла нативного мода Horizon (план 10.2, T72).
# План проверяется настоящим horizon-mixins в CI на закреплённых исходниках;
# сборка лаунчером и запуск игры остаются за автором (шаг 3 плана готовности).
# Плейсхолдеры подставляет `cargo run -p xtask -- bundle`.
[mod]
id = "litospherity"
version = "@VERSION@"

[compatibility]
# Закрепление на точной ночной сборке (план 5.2). Проверить на Windows, что
# ревизия ещё существует как тег nightly-source/<дата>-<коммит>.
horizon_revision = "@HORIZON_REV@"

[[crate]]
id = "core"
path = "crates/litho-core"
dependent = "horizon-core"

[[module]]
id = "glue"
file = "crates/horizon-core/src/lib.rs"
name = "litospherity_glue"
source = "glue/litospherity_glue.rs"
# horizon-world test on real 26.3 resources calls field_for() through this API.
visibility = "pub"

[[injection]]
id = "noise"
kind = "HEAD"
cancellable = true
target = "horizon_core::density::graph::seeded::SeededContext::noise"
helper = "glue/noise_hook.rs"
bindings = [
  { name = "ctx",   ty = "&SeededContext", value = "self" },
  { name = "graph", ty = "&DensityGraph",  value = "graph" },
  { name = "id",    ty = "NoiseId",        value = "id" },
]

# Д-098 (T77, часть 2): сплошная лава ниже −54 только у стыков плит.
# Поля аквифера собираются один раз на мир; в нашем мире клей их оборачивает.
[[injection]]
id = "aquifer"
kind = "HEAD"
cancellable = true
target = "horizon_world::worldgen::material_condition::library::MaterialRuleLibrary::compile_aquifer"
helper = "glue/aquifer_hook.rs"
bindings = [
  { name = "library", ty = "&mut MaterialRuleLibrary", value = "&mut *self" },
  { name = "config",  ty = "AquiferConfig",            value = "config" },
]

# Перед аквифером каждого чанка поток забывает, чей мир он строил.
[[injection]]
id = "aquifer-reset"
kind = "HEAD"
target = "horizon_world::worldgen::aquifer::config::AquiferSamplers::new"
helper = "glue/aquifer_reset_hook.rs"
bindings = []

# В аквифере нашего мира «это лава» -> «нет»: общая лава ниже −54 отключена.
[[injection]]
id = "is-lava"
kind = "HEAD"
cancellable = true
target = "horizon_world::worldgen::aquifer::noise_based::<RegistryAquiferBlockStates<'_> as AquiferBlockStates>::is_lava"
helper = "glue/is_lava_hook.rs"
bindings = []

# К6 (Д-112): все паки (v0, v1-dev обоих режимов и smoke) внутри `.hnmod`.
# Клиентский хук кладёт их в папку паков нового мира, поэтому они видны в
# Data Packs без перетаскивания файлов. Данные генерирует `xtask bundle`
# из `out/bundle/packs`.
[[module]]
id = "packs"
file = "crates/horizon-client/src/title.rs"
name = "litospherity_packs"
source = "glue/packs_data.rs"

[[injection]]
id = "packs-seed-click"
kind = "HEAD"
target = "horizon_client::title::Title::click"
helper = "glue/packs_seed_hook.rs"
bindings = [
  { name = "title", ty = "&mut Title", value = "&mut *self" },
]

[[injection]]
id = "packs-seed-key"
kind = "HEAD"
target = "horizon_client::title::Title::confirm_key_size"
helper = "glue/packs_seed_hook.rs"
bindings = [
  { name = "title", ty = "&mut Title", value = "&mut *self" },
]
