# Шаблон бандла нативного мода Horizon (план 10.2, T72).
# НЕ ПРОВЕРЕН сборкой лаунчера: это эскиз по docs/horizon-mixins, готовится xtask bundle.
# Плейсхолдеры подставляет `cargo run -p xtask -- bundle`.
[mod]
id = "litospherity"
version = "@VERSION@"

[compatibility]
# Закрепление на точной ночной сборке (план 5.2). Проверить на Windows, что
# ревизия ещё существует как тег nightly-source/<дата>-<коммит>.
horizon_revision = "@HORIZON_REV@"

[[crate]]
id = "core"
path = "crates/litho-core"
dependent = "horizon-core"

[[module]]
id = "glue"
file = "crates/horizon-core/src/lib.rs"
name = "litospherity_glue"
visibility = "pub"
source = "glue/litospherity_glue.rs"

[[injection]]
id = "noise"
kind = "HEAD"
cancellable = true
target = "horizon_core::density::graph::seeded::SeededContext::noise"
helper = "glue/noise_hook.rs"
bindings = [
  { name = "ctx",   ty = "&SeededContext", value = "self" },
  { name = "graph", ty = "&DensityGraph",  value = "graph" },
  { name = "id",    ty = "NoiseId",        value = "id" },
]

[[crate]]
id = "packs"
path = "crates/litho-packs"
dependent = "horizon-client-render"

[[injection]]
id = "builtin-packs"
kind = "HEAD"
target = "horizon_client_render::datapack::screen_packs"
helper = "glue/packs_hook.rs"
bindings = [{ name = "dir", ty = "&Path", value = "dir" }]

[[injection]]
id = "exclusive-mode"
kind = "HEAD"
cancellable = true
target = "horizon_client_render::datapack::install"
helper = "glue/packs_guard.rs"
bindings = [{ name = "selected", ty = "&[String]", value = "selected" }]

[[injection]]
id = "lava-settings"
kind = "MODIFY_VARIABLE"
target = "horizon_world::worldgen::generator::OverworldGenerator::for_world_with_settings"
helper = "glue/lava_settings.rs"
variable = { name = "noise_clamped", ordinal = 0, at = "STORE" }
require = 2
ordinal = 0
bindings = [
  { name = "value", ty = "Option<(NoiseSettings, NoiseSettings)>", value = "$value" },
  { name = "settings", ty = "&mut Value", value = "$local_mut:settings_json:0" },
  { name = "data", ty = "&Arc<GeneratorData>", value = "&data" },
  { name = "dimension", ty = "&str", value = "dimension" },
]
